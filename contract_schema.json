{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contract-first-agentic-design-pattern/contract.schema.json",
  "title": "Contract-First Agent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "scope",
    "out_of_scope",
    "assumptions",
    "acceptance_criteria",
    "failure_policy",
    "repair_policy",
    "max_iterations"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "failure_policy": {
      "type": "string",
      "minLength": 1
    },
    "repair_policy": {
      "type": "string",
      "minLength": 1
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "category",
        "statement",
        "verification",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]+$"
        },
        "priority": {
          "type": "string",
          "enum": ["must", "should", "could"]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
